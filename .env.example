# Copy to .env (gitignored) or generate it with: bash scripts/init-env.sh
# Secrets below are placeholders; generate real values with openssl rand.

# Deployment address and port for the app container.
PHX_HOST=shop.example.com
APP_PORT=4100

# TEMPORARY public-access mode for testing: when truthy (true/1/yes/on) every
# visitor is treated as the shop owner and the staff sign-in gate is bypassed.
# OFF by default. Delete or set to "false" to restore normal staff sign-in.
PUBLIC_ACCESS=false

# Local development accepts a bare PostgreSQL database name; production
# requires a complete URL, for example
# postgresql://user:pass@host:5432/robinah_dev (add ?sslmode=require when the
# server only accepts TLS).
DATABASE_URL=robinah_db

# openssl rand -hex 64 — signing key for cookies and tokens (64+ bytes).
SECRET_BASE_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
# Legacy alias of SECRET_BASE_KEY; either name is accepted.
SECRET_KEY_BASE=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS

# openssl rand -hex 32 — keyed digest secret for staff session tokens.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# openssl rand -hex 16 — Phoenix LiveView signing salt.
LIVE_SIGNING_SALT=REPLACE_WITH_A_RANDOM_SALT

# Owner bootstrap account. Existing owner accounts are never overwritten.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS

# PostgreSQL service used by Docker Compose.
POSTGRES_USER=robinah
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=robinah_db
